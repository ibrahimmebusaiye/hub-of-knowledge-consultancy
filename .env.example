# PostgreSQL connection string from Neon/Vercel Marketplace.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Public origin without a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Used once to create the first administrator, then removed from production.
ADMIN_SETUP_TOKEN="replace-with-at-least-32-random-characters"

# Resend notification configuration. Leave RESEND_API_KEY empty during local UI work.
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL="fijacksp@gmail.com"
CONTACT_FROM_EMAIL="Hub of Knowledge <notifications@example.com>"

# Optional comma-separated origins allowed to submit public events.
ALLOWED_ORIGINS="http://localhost:3000"

# Vercel uses this to authorize scheduled cleanup and email-retry requests.
CRON_SECRET="replace-with-at-least-32-random-characters"
